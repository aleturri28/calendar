# cloudinary://api_key:api_secret@cloud_name — senza parentesi angolari
CLOUDINARY_URL=

# In locale: postgresql://postgres@localhost:5432/calendar_dev
# Su Vercel: la connessione con pooling fornita da Neon
DATABASE_URL=

# Connessione diretta, usata solo dalle migrazioni. In locale coincide con DATABASE_URL.
DIRECT_DATABASE_URL=

JWT_SECRET=

USER_A_NAME=
USER_A_PASSWORD=
USER_B_NAME=
USER_B_PASSWORD=

# Connessione diretta a Neon, usata solo da "npm run backup:prod".
# Neon → Connect → disattiva "Connection pooling" → copia (quella senza -pooler).
PROD_DATABASE_URL=

# Facoltativa. Se assente, /api/widget/today risponde 503 e il widget resta spento.
# Generane una con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WIDGET_TOKEN=

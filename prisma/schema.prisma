generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon serve una connessione diretta per le migrazioni, mentre l'app usa
  // quella con pooling. In locale le due coincidono.
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @unique
  passwordHash String
  entries      DayEntry[]
  comments     Comment[]
}

model DayEntry {
  id              Int       @id @default(autoincrement())
  date            String
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  photoUrl        String?
  photoPublicId   String?
  photoUploadedAt DateTime?
  videoUrl        String?
  videoPublicId   String?
  videoDuration   Float?
  videoUploadedAt DateTime?
  createdAt       DateTime  @default(now())
  comments        Comment[]

  @@unique([date, userId])
  @@index([date])
}

model Comment {
  id         Int      @id @default(autoincrement())
  dayEntryId Int
  entry      DayEntry @relation(fields: [dayEntryId], references: [id], onDelete: Cascade)
  // Quale contenuto commenta: 'photo' oppure 'video'.
  target     String
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  text       String
  createdAt  DateTime @default(now())

  @@index([dayEntryId])
}

model Event {
  id          Int     @id @default(autoincrement())
  title       String
  emoji       String?
  startDate   String
  endDate     String
  isMeetup    Boolean @default(false)
  createdById Int

  @@index([startDate])
}
